# FPT Shop Laptop Advisor - mẫu biến môi trường
# Copy file này thành .env rồi điền giá trị: cp .env.example .env

# Gemini API key. Để trống thì hệ thống chạy bằng rule-based fallback (use_llm=false).
GEMINI_API_KEY=

# Model Gemini (mặc định gemini-2.0-flash)
GEMINI_MODEL_INTENT=gemini-2.0-flash
GEMINI_MODEL_ADVICE=gemini-2.0-flash

# Đường dẫn dataset đặc trưng
LAPTOPS_CSV=data/fpt_laptops_features.csv

# Chỉ giữ sản phẩm FPT (true/false)
FPT_ONLY=true
